        Lines.Strings = (
          ';==============================================================================='
          '; K16 Standard Header'
          '; Include at start of all K16 assembly programs'
          ';==============================================================================='
          ''
          ';-------------------------------------------------------------------------------'
          '; ROM Configuration'
          ';-------------------------------------------------------------------------------'
          '             .BASE       $F00000             ; ROM image base address'
          ''
          ';-------------------------------------------------------------------------------'
          '; Memory Map Constants'
          ';-------------------------------------------------------------------------------'
          'ROM_BASE     .EQU        $F00000             ; Start of ROM space'
          'ROM_LOOKUP   .EQU        $F00000             ; Lookup tables (768KB)'
          'ROM_CODE     .EQU        $FC0000             ; Usable code space (256KB)'
          'RAM_BASE     .EQU        $000000             ; Start of RAM'
          ''
          'KEYBOARD     .EQU        $D00000             ; Keyboard'
          'TERMINAL     .EQU        $E00000             ; Terminal'
          ''
          'RESET_VECTOR .EQU        $FF0000             ; CPU reset address'
          'STACK_TOP    .EQU        $010000             ; Initial stack pointer (64KB)'
          ''
          ';-------------------------------------------------------------------------------'
          '; Reset Vector - Entry Point'
          ';-------------------------------------------------------------------------------'
          '             .ORG        RESET_VECTOR'
          ''
          'RESET:'
          '             ; Initialize stack pointer'
          '             LOADI       X3, #<STACK_TOP     ; Load low word of stack address'
          '             LOADI       Y3, #>STACK_TOP     ; Load bank byte (0 for RAM)'
          ''
          '             ; Clear data registers'
          '             LOADI       D0, #0'
          '             LOADI       D1, #0'
          '             LOADI       D2, #0'
          '             LOADI       D3, #0'
          ''
          '             ; Jump to main program'
          '             JMP         MAIN'
          ''
          ';-------------------------------------------------------------------------------'
          '; Main Program - User code starts here'
          ';-------------------------------------------------------------------------------'
          'MAIN:'
          '             ; Your code here'
          '             '
          '             JMP         MAIN                ; Loop forever'
          ''
          ';==============================================================================='
          '; End of K16 Standard Header'
          ';==============================================================================='
        )
        VisibleSpecialChars = [vscSpace, vscTabAtLast]
        RightEdge = 120
        SelectedColor.BackPriority = 50
        SelectedColor.ForePriority = 50
        SelectedColor.FramePriority = 50
        SelectedColor.BoldPriority = 50
        SelectedColor.ItalicPriority = 50
        SelectedColor.UnderlinePriority = 50
        SelectedColor.StrikeOutPriority = 50
