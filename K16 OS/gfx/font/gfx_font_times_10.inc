; Generated by iigs_fon_to_k16.py. cell 9x11, bit15=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from times_10_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA times_10_bits.
; ============================================================================

font_times_10:
                .WORD   32             ; FNT_FIRST
                .WORD   127            ; FNT_LAST
                .WORD   9              ; FNT_WIDTH (cell cols)
                .WORD   11              ; FNT_HEIGHT
                .WORD   10              ; FNT_ADVANCE (mono fallback)
                .WORD   9              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   2112            ; FNT_WTAB (bytes from glyph bits)
                .WORD   2208            ; FNT_OTAB

