; ============================================================================
; courier_9.inc -- ASCII 32..127 (PROPORTIONAL, 5x10 byte/row), generated.
; ----------------------------------------------------------------------------
;   Source: Apple IIGS Courier 9pt QuickDraw font (umich apple2 archive).
; Generated by iigs_fon_to_k16.py. cell 5x10, bit7=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from courier_9_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA courier_9_bits.
; ============================================================================

font_courier_9:
                .WORD   32             ; FNT_FIRST
                .WORD   127            ; FNT_LAST
                .WORD   5              ; FNT_WIDTH (cell cols)
                .WORD   10              ; FNT_HEIGHT
                .WORD   8              ; FNT_ADVANCE (mono fallback)
                .WORD   8              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   960            ; FNT_WTAB (bytes from glyph bits)
                .WORD   1056            ; FNT_OTAB

