; ============================================================================
; courier_10.inc -- ASCII 32..127 (PROPORTIONAL, 6x11 byte/row), generated.
; ----------------------------------------------------------------------------
;   Source: Apple IIGS Courier 10pt QuickDraw font (umich apple2 archive).
; Generated by iigs_fon_to_k16.py. cell 6x11, bit7=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from courier_10_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA courier_10_bits.
; ============================================================================

font_courier_10:
                .WORD   32             ; FNT_FIRST
                .WORD   127            ; FNT_LAST
                .WORD   6              ; FNT_WIDTH (cell cols)
                .WORD   11              ; FNT_HEIGHT
                .WORD   9              ; FNT_ADVANCE (mono fallback)
                .WORD   9              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   1056            ; FNT_WTAB (bytes from glyph bits)
                .WORD   1152            ; FNT_OTAB

