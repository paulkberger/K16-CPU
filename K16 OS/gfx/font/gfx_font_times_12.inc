                .WORD   127            ; FNT_LAST
                .WORD   11              ; FNT_WIDTH (cell cols)
                .WORD   12              ; FNT_HEIGHT
                .WORD   12              ; FNT_ADVANCE (mono fallback)
                .WORD   9              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   2304            ; FNT_WTAB (bytes from glyph bits)
                .WORD   2400            ; FNT_OTAB

