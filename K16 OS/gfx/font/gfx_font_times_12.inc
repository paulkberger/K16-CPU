; Generated by iigs_fon_to_k16.py. cell 11x12, bit15=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from times_12_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA times_12_bits.
; ============================================================================

font_times_12:
