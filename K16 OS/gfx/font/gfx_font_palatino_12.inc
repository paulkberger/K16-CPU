; ============================================================================
; palatino_12.inc -- ASCII 32..127 (PROPORTIONAL, 13x14 word/row), generated.
; ----------------------------------------------------------------------------
;   Source: Apple IIGS Palatino 12pt QuickDraw font (umich apple2 archive).
; Generated by iigs_fon_to_k16.py. cell 13x14, bit15=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from palatino_12_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA palatino_12_bits.
; ============================================================================

font_palatino_12:
                .WORD   32             ; FNT_FIRST
                .WORD   127            ; FNT_LAST
                .WORD   13              ; FNT_WIDTH (cell cols)
                .WORD   14              ; FNT_HEIGHT
                .WORD   15              ; FNT_ADVANCE (mono fallback)
                .WORD   10              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   2688            ; FNT_WTAB (bytes from glyph bits)
                .WORD   2784            ; FNT_OTAB

