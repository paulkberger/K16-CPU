; ============================================================================
; palatino_14.inc -- ASCII 32..127 (PROPORTIONAL, 13x16 word/row), generated.
; ----------------------------------------------------------------------------
;   Source: Apple IIGS Palatino 14pt QuickDraw font (umich apple2 archive).
; Generated by iigs_fon_to_k16.py. cell 13x16, bit15=leftmost. WTAB/OTAB .BYTE arrays indexed by
; (c-FNT_FIRST), byte-offset from palatino_14_bits. Patch FNT_BITS_PG/OF at
; runtime with LEA palatino_14_bits.
; ============================================================================

font_palatino_14:
                .WORD   32             ; FNT_FIRST
                .WORD   127            ; FNT_LAST
                .WORD   13              ; FNT_WIDTH (cell cols)
                .WORD   16              ; FNT_HEIGHT
                .WORD   15              ; FNT_ADVANCE (mono fallback)
                .WORD   12              ; FNT_ASCENT
                .WORD   $0001           ; FNT_FLAGS (FNT_FL_PROP)
                .WORD   0               ; FNT_BITS_PG (patched at runtime)
                .WORD   0               ; FNT_BITS_OF (patched at runtime)
                .WORD   3072            ; FNT_WTAB (bytes from glyph bits)
                .WORD   3168            ; FNT_OTAB

